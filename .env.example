# Copy to .env and fill in. Never commit .env.
# Values come from the Supabase project settings (API + Database).

# --- shared ---
SUPABASE_URL=https://<project-ref>.supabase.co

# --- backend only: never ship these to a client ---
SUPABASE_SERVICE_ROLE_KEY=      # bypasses RLS
SUPABASE_JWT_SECRET=            # verifies Supabase tokens, signs guest tokens
DATABASE_URL=                   # session-pooler connection string

# --- web (Vite requires the VITE_ prefix to expose a value) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8000

# --- mobile (Expo requires the EXPO_PUBLIC_ prefix) ---
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=http://localhost:8000
